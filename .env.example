# Sample environment variables for the CMS API (public/api/config.php).
# These are real OS/PHP environment variables (set via hPanel's PHP Configuration
# on Hostinger, or exported before `php -S ...` locally) — this file is
# documentation only and is not automatically loaded by the app.
#
# Never commit a copy of this file with real secrets filled in.

# One-time token required to create the first admin account via the admin
# login page's "First time here?" link. Required only until setup is complete;
# see INITIAL-ADMIN-SETUP.md. Leave unset to keep setup disabled.
CMS_SETUP_TOKEN=

# Only needed if the admin SPA is genuinely served from a different origin than
# the API (uncommon — same-origin is the default and recommended setup).
CMS_ALLOWED_ORIGIN=

# Maximum media upload size in bytes. Defaults to 8388608 (8MB) if unset.
CMS_MAX_UPLOAD_BYTES=8388608

# "production" (default) suppresses PHP error display; set to "development"
# only on a local machine, never on a public server.
CMS_ENV=production
